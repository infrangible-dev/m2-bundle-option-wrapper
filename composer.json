{
    "name": "infrangible/m2-bundle-option-wrapper",
    "description": "Groundwork for other Infrangible modules: puts each option on bundle product pages into its own container, so options can be styled and extended individually.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Bundle products"
    ],
    "homepage": "https://www.infrangible.dev/modules/bundle-option-wrapper",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.1",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-bundle": "~101.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\BundleOptionWrapper\\": "src"
        }
    }
}
